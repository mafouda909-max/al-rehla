# ------------------------------------------------------------------
# THE JOURNEY — Environment configuration
# Copy to `.env` for local development. Never commit `.env`.
# ------------------------------------------------------------------

# PostgreSQL connection string (Drizzle + node-postgres/postgres-js).
# The full URL is required to run migrations and for the API to persist.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/al_rehla

# Base URL of the application (used for cookies, links, and knowing prod).
APP_URL=http://localhost:3000

# Node environment. Leave as "development" locally, "production" in deploy.
NODE_ENV=development

# Comma-separated list of allowed origins for state-changing requests
# (CSRF double-submit referer/origin check). Best-effort defense-in-depth.
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Session duration in seconds (default 7 days = 604800).
SESSION_TTL_SECONDS=604800

# ------------------------------------------------------------------
# Neon Auth (external identity provider; replaces the internal
# bcrypt+sessions auth). Both must be set for auth to be active.
# ------------------------------------------------------------------
# Base URL of your Neon Auth instance (from the Neon project console).
# Example: https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# Secret for signing Neon Auth session cookies. MUST be at least 32 chars.
# Generate with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Set to "1"/"true" to log DB/API errors with stack traces during dev.
DEV_DEBUG=1
